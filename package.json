{
  "name": "seatbuddy",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run package && playwright test --project=extension",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run icons:check && npm test && npm run build",
    "test:ui": "npm run build && playwright test --project=ui",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "test:adversarial": "vitest run tests/unit/companion.test.ts tests/unit/retention.test.ts tests/unit/buddies.test.ts tests/unit/adapter.test.ts tests/unit/read-only.test.ts tests/unit/read-only-messages.test.ts tests/unit/seat-policy.test.ts tests/unit/zero-extra-manual.test.ts tests/unit/normal-context.test.ts tests/unit/worker.test.ts tests/unit/self-test.test.ts",
    "test:smoke:chrome": "npm run package && playwright test --project=extension --grep @smoke"
  },
  "dependencies": {
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
