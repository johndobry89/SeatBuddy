{
  "manifest_version": 3,
  "name": "SeatBuddies \u2014 samen naar de film (test)",
  "version": "0.9.0",
  "description": "Plan solo of samen. Controleer je filmavond en volg de eigen stappen. Geen live boekingsintegratie.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SeatBuddies",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "version_name": "0.9.0-test (Sprint 09)",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
