{
  "manifest_version": 3,
  "name": "SeatMates — handmatige A/B-assistent (test)",
  "version": "0.2.0",
  "description": "Plan één filmavond met twee onafhankelijke handmatige stappenlijsten. Geen live boekingsintegratie.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SeatMates"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "version_name": "0.2.0-test (Sprint 02)"
}
